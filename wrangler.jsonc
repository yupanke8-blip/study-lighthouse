// Allow initial deployment before runtime secrets are bound.
// backend/worker.js fails closed if either secret is missing and requires authentication.
{
  "name": "study-lighthouse",
  "main": "backend/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": {
    "DEEPSEEK_MODEL": "deepseek-flash"
  },
  "observability": {
    "enabled": false
  }
}

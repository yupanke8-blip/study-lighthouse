{
  "name": "study-lighthouse",
  "main": "backend/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": {
    "DEEPSEEK_MODEL": "deepseek-flash"
  },
  "secrets": {
    "required": [
      "DEEPSEEK_API_KEY",
      "STUDY_ACCESS_TOKEN"
    ]
  },
  "observability": {
    "enabled": false
  }
}
